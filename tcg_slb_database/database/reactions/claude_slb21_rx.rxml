  <phase name="Kyanite_slb21_ph"/>
  <phase name="Spinel_slb21_ph"/>
  <phase name="Olivine_slb21_ph"/>
  <reaction_rate name="R">
    <variable name="T">
      <rank name="Scalar"/>
      <units>K</units>
    </variable>
    <variable name="P">
      <rank name="Scalar"/>
      <units>bar</units>
    </variable>
    <variable name="C">
      <rank name="Matrix">
        <n_rows>N</n_rows>
        <n_cols>Kmax</n_cols>
      </rank>
      <units>None</units>
    </variable>
    <variable name="Phi">
      <rank name="Vector">
        <size>N</size>
      </rank>
      <units>%</units>
    </variable>
    <function name="A">
      <type name="external">
        <rank name="Vector">
          <size>J</size>
        </rank>
        <variable name="T">
          <rank name="Scalar"/>
          <units>K</units>
        </variable>
        <variable name="P">
          <rank name="Scalar"/>
          <units>bar</units>
        </variable>
        <variable name="C">
          <rank name="Matrix">
            <n_rows>N</n_rows>
            <n_cols>Kmax</n_cols>
          </rank>
          <units>None</units>
        </variable>
      </type>
    </function>
    <function name="rho">
      <type name="external">
        <rank name="Vector">
          <size>J</size>
        </rank>
        <variable name="T">
          <rank name="Scalar"/>
          <units>K</units>
        </variable>
        <variable name="P">
          <rank name="Scalar"/>
          <units>bar</units>
        </variable>
      </type>
    </function>
  </reaction_rate>
  <global_parameters>
    <parameter name="T0">
      <rank name="Scalar">
        <value>
          <real_value rank="0">2000</real_value>
        </value>
        <units>
          <string_value lines="1">'K'</string_value>
        </units>
      </rank>
    </parameter>
    <parameter name="R">
      <rank name="Scalar">
        <value>
          <real_value rank="0">8.31446261815324</real_value>
        </value>
        <units>
          <string_value lines="1">'J/mol/K'</string_value>
        </units>
      </rank>
    </parameter>
  </global_parameters>
  <reaction name="Clin_Enst">
    <reactant name="Clin_Clin" phase="Clinopyroxene_slb21_ph" endmember="Clinoenstatite_slb21_em"/>
    <product name="Enst_Orth" phase="Orthopyroxene_slb21_ph" endmember="Enstatite_slb21_em"/>
    <expression>
      <string_value type="code" language="python" lines="20">Clin_Enst = (
Piecewise((exp(-T0/T)*A[0, 0]*Phi[0, 0]/(R*T), A[0, 0] &gt;= 0),
(exp(-T0/T)*A[0, 0]*Phi[1, 0]/(R*T), True))
)</string_value>
    </expression>
  </reaction>
